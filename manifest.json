{
    "manifest_version": 3,
    "name": "X Reply Generator",
    "version": "0.1.0",
    "description": "Drafts one short casual reply for an X post. You copy and post it yourself.",
    "permissions": ["storage"],
    "host_permissions": ["https://x.com/*", "https://api.anthropic.com/*"],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": ["https://x.com/*"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/16.png",
            "32": "icons/32.png",
            "48": "icons/48.png",
            "128": "icons/128.png"
        }
    },
    "icons": {
        "16": "icons/16.png",
        "32": "icons/32.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
    },
    "options_page": "options.html"
}
